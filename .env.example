# Dashboard authentication: login password and Bearer token for the tick
# endpoint. Minimum 8 characters; a shorter one rejects every request.
# Generate one with: openssl rand -hex 24
DASHBOARD_SECRET="replace-with-at-least-8-chars-secret"

# Stable secret for encrypting custom agent credentials (falls back to DASHBOARD_SECRET).
# Back it up securely; changing it makes existing encrypted credentials unreadable.
NEIRO_ENCRYPTION_KEY=""

# Login limiter: number of trusted reverse proxies between clients and Neiro.
# 0 ignores IP headers and shares the fallback bucket. Set e.g. 1 only when
# the proxy appends/overwrites X-Forwarded-For and direct origin access is blocked.
# Use a fixed proxy chain; x-real-ip is never trusted. Passcode failures also
# share a global lock (5 failures / 15 min) within this single server process.
NEIRO_TRUSTED_PROXY_HOPS="0"

# Supabase (Server-only service role)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Hermes Agent VPS Runtime
HERMES_DEFAULT_URL="http://127.0.0.1:8642"
HERMES_DEFAULT_KEY="your-hermes-secret-key"
# Leave empty to use the provider of each Hermes profile.
HERMES_PROVIDER_SLUG=""

# Task router (Laya) — server-only. Laya picks the agent for each queued task;
# the orchestrator still runs every task.
# Set to "off" to disable the router (tasks are claimed directly, old behaviour).
NEIRO_ROUTER="on"
# Local Laya model directory (or Hugging Face repo id). Empty = router off.
NEIRO_LAYA_MODEL_PATH=""
# Max time for one routing decision, in ms. On timeout the default worker is used.
NEIRO_ROUTER_TIMEOUT_MS="5000"

# Local orchestrator ticks. Unset = on under `bun run dev`, off under
# `next start` (production uses the cron in deploy/neiro-tick.cron).
NEIRO_LOCAL_TICK=""
# Tick interval in ms (minimum 5000).
NEIRO_LOCAL_TICK_MS="15000"
# Where mission git worktrees are created. Empty = ~/.neiro/worktrees
NEIRO_WORKTREE_ROOT=""

# Outgoing notifications (server-only). Format of NEIRO_NOTIFY_WEBHOOK_URL's
# body: generic (text + actions), slack (Block Kit buttons) or discord
# (message components). Slack and Discord refuse fields of the other format.
NEIRO_NOTIFY_WEBHOOK_URL=""
NEIRO_NOTIFY_WEBHOOK_FORMAT="generic"
# Public base URL used in notification links, e.g. https://neiro.example
NEIRO_PUBLIC_URL=""

# Two-way bot (server-only, never NEXT_PUBLIC_). Telegram notifications with
# buttons, and commands (/mission, /status, /approve, /deny, /clarify, /ask)
# sent to POST /api/bot/webhook. Only messages from this chat are obeyed.
NEIRO_TELEGRAM_BOT_TOKEN=""
NEIRO_TELEGRAM_CHAT_ID=""
# Shared secret for POST /api/bot/webhook, at least 16 characters (it is not
# DASHBOARD_SECRET). Telegram: pass it as secret_token to setWebhook.
# Generate one with: openssl rand -hex 24
NEIRO_BOT_WEBHOOK_SECRET=""

# Optional Jev cloud router; local Laya remains the default.
NEIRO_ROUTER_PROVIDER="laya"
TYPESAFE_API_KEY=""
TYPESAFE_MODEL="jev-latest"
TYPESAFE_BASE_URL="https://api.typesafe.ai"

# Optional global safe-check approval, off by default.
NEIRO_AUTO_APPROVE_SAFE="off"
